 및 12조, 같은법 시행령 제4조 및 15조에 따라 재정비촉진지구 변경지정 및 재정비촉진계획 변경결정하고 같은법 제5조제5항 및 제12조제3항, 같은법 시행령 제5조 및 제15조에 따라 이를 고시하고, 「토지이용규제 기본법」 제8조에 따라 지형도면을 고시합니다.","noticeStatus":"NTS0002","tempYn":"N","gubun":"1","dcsnobj":"기존 존치정비구역을 촉진사업의 도래로 촉진구역으로 지정하여 사업을 하기 위함","dcsnwayNm":{"cmnCode":"PBLICT01","cmnDesc":"게재수단 시보코드","cmnName":"시보","crtDt":"2018-10-24T14:33:36.000","odrNo":1,"udtDt":"2018-10-24T14:33:36.000","crtUsrId":"sysadmin","typeCode":"PBLICTCODE","udtUsrId":"sysadmin","useYn":"Y"},"dcsnway":"PBLICT01","site":"서울특별시 재정비과, 서대문구청 도시재정비과","phone":"330-1633","decide":"Y","contTxt":"가재울 재정비촉진지구 변경지정, 재정","subject":"서울특별시 | 2012-144","key":"11000NTC201206076508"},"classifyGnm":{"classifyCode":"UQS001","groupname":"도시계획시설","upisLayerCode":"UQ151","upisLayerName":"교통시설","classifyG":"UQS001","classifyCodeName":"교통시설","useYn":"Y"},"classifyMnm":{"classifyCode":"UQS100","groupname":"도시계획시설","upisLayerCode":"UQ151","upisLayerName":"교통시설","classifyG":"UQS001","classifyM":"UQS100","classifyCodeName":"도로","useYn":"Y"},"classifyLnm":{"classifyCode":"UQS122","groupname":"도시계획시설","upisLayerCode":"UQ151","upisLayerName":"교통시설","classifyG":"UQS001","classifyM":"UQS100","classifyL":"UQS122","classifyCodeName":"소로3류","useYn":"Y"},"siteCodeNm":{"siteCode":"11000","siteName":"서울특별시","siteCnt":0},"_category":"도시계획시설"},"district_plan":{}},{"id":"11000URZ199809245624","name":"소로3류","category":"도시계획시설","layers":["UPIS_C_UQ151"],"links":[{"district_id":"11000UQ120PS202505310019","layer":"UPIS_C_UQ151","layer_id":3,"object_id":2487422,"record_id":"11000URZ199809245624","business_id":"11000UQ151PS201912154045","name":"소로3류","overlap_m2":8.4424,"attributes":{"OBJECTID":2487422,"PRESENT_SN":"11000UQ151PS201912154045","LCLAS_CL":"UQS122","MLSFC_CL":" ","SCLAS_CL":" ","ATRB_SE":"UQS122","WTNNC_SN":"11000URZ199809245624","NTFC_SN":"11000NTC199809248259","DGM_NM":"소로3류","SIGNGU_SE":"11000","GRAD_SE":"소로","ROAD_TY":"3","ROAD_NO":" ","ROAD_ROLE":"PMI0004","DRAWING_NO":" ","EXCUT_SE":"EMA0009","CREATE_DAT":1